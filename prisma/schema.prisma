generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  createdAt     DateTime  @default(now())

  accounts Account[]
  sessions Session[]
  player   Player?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Player {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  streakNights Int      @default(0)
  userId       String?  @unique

  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  soundies        Soundie[]
  sessions        ListenSession[]
  dailyVisits     DailyVisit[]
  dailyClaims     DailyClaim[]
  moodEntries     MoodEntry[]
  analyticsEvents AnalyticsEvent[]
  teardropFocusSessions TeardropFocusSession[]
  teardropUnlocks TeardropCardUnlock[]
  teardropProgress TeardropProgress?
  teardropXpEvents TeardropXpEvent[]
  mindfulMoments MindfulMomentLog[]
}

model Soundie {
  id              String   @id @default(cuid())
  playerId        String
  noteId          String
  level           Int      @default(1)
  totalListenTime Int      @default(0)
  loreUnlocked    Int      @default(0)
  discoveredAt    DateTime @default(now())
  lastSeenAt      DateTime @updatedAt

  player   Player          @relation(fields: [playerId], references: [id], onDelete: Cascade)
  note     Note            @relation(fields: [noteId], references: [id], onDelete: Restrict)
  sessions ListenSession[]

  @@unique([playerId, noteId])
  @@index([playerId])
  @@index([noteId])
}

model ListenSession {
  id          String   @id @default(cuid())
  playerId    String
  soundieId   String
  duration    Int
  completedAt DateTime @default(now())

  player  Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  soundie Soundie @relation(fields: [soundieId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([soundieId])
}

model Emotion {
  id          String  @id
  namePl      String
  nameEn      String?
  descriptionPl String
  descriptionEn String?
  notes       Note[]
  teardropCards TeardropCard[]
}

model TeardropDeck {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  version   String
  source    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cards     TeardropCard[]
  phases    TeardropPhase[]
}

model TeardropPhase {
  id          String   @id @default(cuid())
  deckId      String
  slug        String
  titlePl     String
  titleEn     String
  unlockOrder Int
  xpPerUnlock Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deck        TeardropDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@unique([deckId, slug])
  @@index([deckId, unlockOrder])
}

model TeardropCard {
  id          String   @id @default(cuid())
  deckId      String
  slug        String
  name        String
  phase       String?
  phaseOrder  Int?
  arcanaType  String
  suit        String?
  cardNumber  Int?
  sourcePath  String
  isTemplate  Boolean  @default(false)
  emotionId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deck        TeardropDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  emotion     Emotion?     @relation(fields: [emotionId], references: [id], onDelete: SetNull)
  texts       TeardropCardText[]
  noteLinks   NoteTeardropCard[]
  dailyClaims DailyClaim[]
  focusSessions TeardropFocusSession[]
  outgoing    TeardropCardRelation[] @relation("TeardropOutgoing")
  incoming    TeardropCardRelation[] @relation("TeardropIncoming")
  unlocks     TeardropCardUnlock[]

  @@unique([deckId, slug])
  @@index([emotionId])
  @@index([slug])
  @@index([phase, phaseOrder])
}

model TeardropProgress {
  id            String   @id @default(cuid())
  playerId      String   @unique
  xp            Int      @default(0)
  unlockedCards Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  player        Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

model TeardropCardUnlock {
  id         String   @id @default(cuid())
  playerId   String
  noteId     String
  cardId     String
  phase      String
  phaseOrder Int?
  xpAwarded  Int
  createdAt  DateTime @default(now())

  player     Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  note       Note         @relation(fields: [noteId], references: [id], onDelete: Cascade)
  card       TeardropCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([playerId, noteId, cardId])
  @@index([playerId, noteId, createdAt])
  @@index([playerId, createdAt])
}

enum TeardropXpSource {
  cycle
  teardrop_unlock
  event
}

model TeardropXpEvent {
  id        String           @id @default(cuid())
  playerId  String
  noteId    String?
  source    TeardropXpSource
  amount    Int
  createdAt DateTime         @default(now())

  player    Player           @relation(fields: [playerId], references: [id], onDelete: Cascade)
  note      Note?            @relation(fields: [noteId], references: [id], onDelete: SetNull)

  @@index([playerId, createdAt])
  @@index([playerId, source, createdAt])
  @@index([noteId, createdAt])
}

model TeardropFocusSession {
  id         String   @id @default(cuid())
  playerId   String
  noteId     String
  cardId     String
  durationMs Int
  startedAt  DateTime
  endedAt    DateTime
  source     String?
  createdAt  DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  card   TeardropCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([playerId, createdAt])
  @@index([playerId, noteId, createdAt])
  @@index([playerId, cardId, createdAt])
}

model TeardropCardText {
  id        String   @id @default(cuid())
  cardId    String
  locale    String
  field     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  card      TeardropCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([cardId, locale, field])
  @@index([cardId, locale])
}

model TeardropCardRelation {
  id          String @id @default(cuid())
  fromCardId  String
  toCardId    String
  relationType String

  fromCard    TeardropCard @relation("TeardropOutgoing", fields: [fromCardId], references: [id], onDelete: Cascade)
  toCard      TeardropCard @relation("TeardropIncoming", fields: [toCardId], references: [id], onDelete: Cascade)

  @@unique([fromCardId, toCardId, relationType])
  @@index([fromCardId])
  @@index([toCardId])
}

model DailyVisit {
  id         String   @id @default(cuid())
  playerId   String
  visitDate  String
  createdAt  DateTime @default(now())
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, visitDate])
  @@index([playerId])
}

model DailyClaim {
  id              String   @id @default(cuid())
  playerId        String
  claimDate       String
  noteId          String
  glowKey         String
  rareCaption     String
  teardropCardId  String
  createdAt       DateTime @default(now())
  player          Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  note            Note         @relation(fields: [noteId], references: [id], onDelete: Restrict)
  teardropCard    TeardropCard @relation(fields: [teardropCardId], references: [id], onDelete: Restrict)

  @@unique([playerId, claimDate])
  @@index([playerId])
  @@index([claimDate])
}

model MoodEntry {
  id         String   @id @default(cuid())
  playerId   String
  noteId     String
  mood       String
  entryDate  String
  createdAt  DateTime @default(now())
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  note       Note     @relation(fields: [noteId], references: [id], onDelete: Restrict)

  @@index([playerId, entryDate])
  @@index([playerId, createdAt])
  @@index([mood, createdAt])
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  playerId   String?
  name       String
  meta       Json?
  createdAt  DateTime @default(now())
  player     Player?  @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@index([name, createdAt])
  @@index([playerId, createdAt])
}

model Note {
  id                 String         @id
  short              String
  name               String
  frequency          Float
  urlKey             String         @unique
  locked             Boolean
  healing            String
  chromaHex          String
  synestheticTitlePl String
  synestheticLinePl  String
  element            String
  sortOrder          Int
  emotionId          String?
  healingStyle       String?
  emotion            Emotion?       @relation(fields: [emotionId], references: [id])
  fragments          LoreFragment[]
  captions           NoteCaption[]
  soundies           Soundie[]
  teardropCards      NoteTeardropCard[]
  teardropFocusSessions TeardropFocusSession[]
  teardropUnlocks    TeardropCardUnlock[]
  teardropXpEvents   TeardropXpEvent[]
  dailyClaims        DailyClaim[]
  moodEntries        MoodEntry[]

  @@index([sortOrder])
}

model NoteTeardropCard {
  id         String @id @default(cuid())
  noteId     String
  cardId     String
  sortOrder  Int
  note       Note        @relation(fields: [noteId], references: [id], onDelete: Cascade)
  card       TeardropCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([noteId, cardId])
  @@unique([noteId, sortOrder])
  @@index([noteId])
  @@index([cardId])
}

model NoteCaption {
  id         String @id @default(cuid())
  noteId     String
  locale     String @default("en")
  orderIndex Int
  body       String
  note       Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([noteId, locale, orderIndex])
  @@index([noteId])
}

model MindfulMomentLog {
  id          String   @id @default(cuid())
  playerId    String
  type        String   @default("fly")
  noteId      String?
  completedAt DateTime @default(now())

  player      Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, completedAt])
  @@index([playerId, type])
}

model LoreFragment {
  id         String @id @default(cuid())
  noteId     String
  orderIndex Int
  locale     String @default("en")
  body       String
  note       Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([noteId, orderIndex, locale])
  @@index([noteId, locale])
}
