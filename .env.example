DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Production site URL (https, no trailing slash) — used for canonical links, sitemap, Open Graph, and JSON-LD
NEXT_PUBLIC_SITE_URL="https://example.com"

# Auth.js v5 — generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-here"

# Auth.js v5 — full URL of the app (no trailing slash)
# Vercel production: set to https://your-domain.com (same as NEXT_PUBLIC_SITE_URL). trustHost in auth.ts helps preview URLs; production should still set this.
AUTH_URL="http://localhost:3000"

# Outgoing email (OTP): primary path is SMTP. Optional From; if empty, uses SMTP_USER as "Soundie <...>"
EMAIL_FROM=""

# SMTP (Nodemailer on Vercel Node serverless) — set all in Vercel → Project → Environment Variables
# If sending fails: many providers require SMTP from known IPs; Vercel uses shared egress — use a provider that allows it, a relay, or Resend with SMTP_HOST unset.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER="me@soundie.world"
SMTP_PASS=""
# Optional: "true" / "1" for implicit TLS; if unset, secure is on when port is 465
SMTP_SECURE="true"

# Resend (optional; used only if SMTP_HOST is not set)
RESEND_API_KEY=""
# If EMAIL_FROM and SMTP user not used for from: no-reply@<domain> (Resend)
RESEND_FROM_DOMAIN=""
